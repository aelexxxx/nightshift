# ── Model auth (pick ONE) ────────────────────────────────────────────────
# Option A: Anthropic API key (pay per token)
ANTHROPIC_API_KEY=

# Option B: Claude subscription (Pro/Max). Generate with: claude setup-token
# Leave ANTHROPIC_API_KEY empty if you use this.
CLAUDE_CODE_OAUTH_TOKEN=

# Default model for the CEO loop. Override per company in company.yaml.
# Examples: claude-sonnet-4-5, claude-opus-4-6, claude-haiku-4-5
NIGHTSHIFT_MODEL=claude-sonnet-4-5

# Optional: point at an Anthropic-compatible gateway (LiteLLM proxy, etc.)
# to swap in non-Claude models. See README "Swapping models".
# ANTHROPIC_BASE_URL=http://localhost:4000

# ── Owner ────────────────────────────────────────────────────────────────
# Where morning reports and alerts are sent.
OWNER_EMAIL=you@example.com

# ── Email channel (Gmail: create an App Password, not your real password) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=

# ── X / Twitter (developer.x.com → free tier, OAuth 1.0a user context) ───
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── GitHub (fine-grained PAT with repo scope) ────────────────────────────
GITHUB_TOKEN=
GITHUB_USER=

# ── Scheduler ────────────────────────────────────────────────────────────
# Local time the nightly run starts (24h). Companies are staggered 20 min apart.
NIGHTSHIFT_RUN_AT=02:00
